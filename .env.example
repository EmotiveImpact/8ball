# Export variables in your shell. No .env autoload is performed.
# EIGHTBALL_TOKEN=<at-least-32-random-characters>
# EIGHTBALL_DB=/absolute/private/path/cases.sqlite3
# TYPESAFE_API_KEY=<server-side-only>
EIGHTBALL_JEV_MODEL=jev-1.13.0
EIGHTBALL_OLLAMA_MODEL=qwen3.5:4b

# Optional exact cached model revision for repeatable GLiClass experiments.
EIGHTBALL_GLICLASS_REVISION=df03993a2ed98e5e4a0d2dd7efbbd105abe874cf

# Optional hosted development. No default model/provider and no automatic calls.
# Keep HF_TOKEN in the private server environment, never in a committed .env.
# HF_TOKEN=<private-fine-grained-token-with-inference-permission>
# EIGHTBALL_HF_MODEL=<namespace/model>
# EIGHTBALL_HF_PROVIDER=<explicit-provider-not-auto>

# Owner-selected Anthropic native Messages adapter; opt in explicitly.
# No .env autoload, automatic live call or model fallback.
# Confirm authorised budget, pricing and billing controls before inference.
# The test budget is not a provider-enforced account cap.
# EIGHTBALL_API_BASE_URL=https://api.anthropic.com/v1
# EIGHTBALL_API_MODEL=claude-sonnet-5-5
# EIGHTBALL_API_PROVIDER=anthropic
# EIGHTBALL_API_KEY=<private-Anthropic-key-in-server-environment-only>
# Leave EIGHTBALL_API_ROUTING_PROVIDER unset for direct Anthropic.
